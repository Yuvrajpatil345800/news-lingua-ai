# Set these in Vercel Project Settings → Environment Variables. Never commit real values.
MONGODB_URI=mongodb+srv://NewsSummarizer_admin:<>@ai-news-summarizer.ofrtms9.mongodb.net/?appName=AI-News-Summarizer
JWT_SECRET=generate-a-long-random-value-at-least-32-characters
# Comma-separated allowed frontend domains. Use your local URL during development.
FRONTEND_ORIGINS=https://your-app.vercel.app
# Exact URL used inside verification and password-reset emails.
FRONTEND_URL=https://your-app.vercel.app
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
GROQ_API_KEY=your_groq_api_key
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
NEWS_API_KEY=your_news_api_key
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=your_azure_speech_region
